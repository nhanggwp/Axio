DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low
TRUST_PROXY=0
PORT=3001
HOST=127.0.0.1

# Production origin must exactly match the browser origin and use HTTPS.
# Dev accepts localhost/127.0.0.1 loopback aliases on this same scheme and port.
APP_ORIGIN=http://127.0.0.1:5173
BETTER_AUTH_SECRET=
DATABASE_PATH=data/axio.sqlite
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Axio <no-reply@example.com>
# Trial: set true to re-enable the daily limits below.
AI_DAILY_LIMIT_ENABLED=false
AI_GUEST_DAILY_LIMIT=20
AI_USER_DAILY_LIMIT=100
AI_REQUESTS_PER_MINUTE=12
AUTH_REQUESTS_PER_MINUTE=30
AUTH_SIGNIN_PER_MINUTE=8

# Local SMTP option: npm run mail:dev, then set SMTP_HOST=127.0.0.1 and SMTP_PORT=2525.
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain, stable BETTER_AUTH_SECRET.
